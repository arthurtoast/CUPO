# Supabase. En local, toma los valores de: npx supabase status -o env
# API_URL -> NEXT_PUBLIC_SUPABASE_URL, PUBLISHABLE_KEY -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional: cuántos días ofrece la página pública de reserva (1 a 60, por defecto 14).
# CUPO_DIAS_VISIBLES=14

# --- Correos de confirmación y aviso (HU-12) ---
# Sin SMTP_HOST no se envían correos (la reserva funciona igual).
# En local: el buzón de prueba de Supabase. Los correos se ven en http://127.0.0.1:54324
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
# En producción, los datos de tu proveedor de correo, por ejemplo:
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587            # 465 con SMTP_SECURE=true
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# CORREO_REMITENTE="Cupo <no-responder@tudominio.com>"
# SMTP_TIMEOUT_MS=10000
# Base de los enlaces de los correos; si falta, se usa la dirección con la que se abrió la página.
# CUPO_URL_PUBLICA=https://tudominio.com

# Llave secreta de Supabase, solo para el servidor: con ella se lee el correo del
# dueño para avisarle de cada cita. Sin ella, el cliente recibe su correo y el aviso
# al negocio se omite. En local: SECRET_KEY de `npx supabase status -o env`.
# Nunca la pongas en una variable NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
